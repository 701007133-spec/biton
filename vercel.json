{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/page.js": {
      "includeFiles": "{sites,categories}/**/*.html"
    },
    "api/pages.js": {
      "includeFiles": "{sites,categories}/**/*.html"
    },
    "api/mcp.js": {
      "includeFiles": "{sites,categories}/**/*.html"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/mcp.html"
    },
    {
      "source": "/:slug",
      "destination": "/api/page?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}